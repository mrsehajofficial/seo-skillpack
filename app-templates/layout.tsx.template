import type { Metadata, Viewport } from "next";
import { SITE_CONFIG } from "@/config/site-config.example"; // Adjust import path
import { SITE_URL, SITE_NAME } from "@/lib/site";
import { getPrimaryEntityNode } from "@/lib/entity";
import { getWebSiteSchema, getSpeakableSchema } from "@/lib/jsonld";

/**
 * ============================================================================
 * ROOT LAYOUT TEMPLATE (Next.js App Router)
 * ============================================================================
 *
 * Why this layout supports strong SEO:
 * 1. Global metadataBase ensures all relative URLs resolve to the single canonical origin.
 * 2. Unifies WebSite and Person/Org schemas in the initial SSR HTML stream.
 * 3. Incorporates SpeakableSpecification so voice assistants & Google AI cite you.
 * 4. Semantic HTML5 tags (skip-link, main landmark) support good Core Web Vitals & accessibility.
 */

// ── Root Metadata ───────────────────────────────────────────────────────────
export const metadata: Metadata = {
  metadataBase: new URL(SITE_URL),
  applicationName: SITE_NAME,
  title: {
    default: SITE_CONFIG.siteTitle,
    template: `%s — ${SITE_CONFIG.shortName}`,
  },
  description: SITE_CONFIG.siteDescription,
  keywords: SITE_CONFIG.defaultKeywords,
  authors: [{ name: SITE_CONFIG.entity.name, url: SITE_URL }],
  creator: SITE_CONFIG.entity.name,
  publisher: SITE_CONFIG.entity.name,

  // Versioned icons (Change v1 to v2 whenever updating to prompt Google to re-fetch!)
  icons: {
    icon: [
      { url: "/favicon-v1.ico", sizes: "any" },
      { url: "/favicon-v1.svg", type: "image/svg+xml" },
      { url: "/icon-192-v1.png", type: "image/png", sizes: "192x192" },
      { url: "/icon-512-v1.png", type: "image/png", sizes: "512x512" },
    ],
    apple: [
      { url: "/apple-touch-icon-v1.png", sizes: "180x180", type: "image/png" },
    ],
  },

  robots: {
    index: true,
    follow: true,
    "max-video-preview": -1,
    "max-image-preview": "large",
    "max-snippet": -1,
    googleBot: {
      index: true,
      follow: true,
      "max-video-preview": -1,
      "max-image-preview": "large",
      "max-snippet": -1,
    },
  },

  openGraph: {
    type: "website",
    locale: "en_US",
    url: SITE_URL,
    siteName: SITE_NAME,
    title: SITE_CONFIG.siteTitle,
    description: SITE_CONFIG.siteDescription,
    images: [
      {
        url: SITE_CONFIG.ogImage.url,
        width: SITE_CONFIG.ogImage.width,
        height: SITE_CONFIG.ogImage.height,
        alt: SITE_CONFIG.ogImage.alt,
      },
    ],
  },

  twitter: {
    card: "summary_large_image",
    title: SITE_CONFIG.siteTitle,
    description: SITE_CONFIG.siteDescription,
    images: [SITE_CONFIG.ogImage.url],
  },

  alternates: {
    canonical: SITE_URL,
  },

  // Search Engine Verification (Optional)
  verification: {
    google: SITE_CONFIG.searchVerification?.google,
    other: {
      "msvalidate.01": SITE_CONFIG.searchVerification?.bing || "",
    },
  },
};

// ── Viewport Specification ──────────────────────────────────────────────────
export const viewport: Viewport = {
  themeColor: SITE_CONFIG.themeColor,
  colorScheme: "light dark",
  width: "device-width",
  initialScale: 1,
};

// ── Root JSON-LD Knowledge Graph ────────────────────────────────────────────
const rootJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    getWebSiteSchema(),
    getPrimaryEntityNode({
      speakable: getSpeakableSchema(["h1", ".hero-headline", ".entity-summary"]),
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": SITE_URL,
      },
    }),
  ],
};

export default function RootLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  return (
    <html lang="en">
      <head>
        {/* Inject Master Knowledge Graph into SSR stream */}
        <script
          type="application/ld+json"
          dangerouslySetInnerHTML={{ __html: JSON.stringify(rootJsonLd) }}
        />
      </head>
      <body>
        {/* Accessibility & SEO Landmark: Skip to content */}
        <a href="#main-content" className="sr-only focus:not-sr-only">
          Skip to content
        </a>

        {/* Semantic main container */}
        <main id="main-content">
          {children}
        </main>
      </body>
    </html>
  );
}
