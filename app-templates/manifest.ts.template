import { MetadataRoute } from "next";
import { SITE_CONFIG } from "@/config/site-config.example"; // Adjust import path
import { SITE_NAME } from "@/lib/site";

/**
 * ============================================================================
 * WEB APP MANIFEST (Next.js App Router)
 * ============================================================================
 *
 * Why this matters for Google Search:
 * Google uses web app manifest metadata to verify brand name consistency,
 * brand icons, and mobile optimization signals.
 */

export default function manifest(): MetadataRoute.Manifest {
  return {
    name: SITE_NAME,
    short_name: SITE_CONFIG.shortName,
    description: SITE_CONFIG.siteDescription,
    start_url: "/",
    display: "standalone",
    background_color: SITE_CONFIG.backgroundColor,
    theme_color: SITE_CONFIG.themeColor,
    icons: [
      {
        src: "/icon-192-v1.png",
        sizes: "192x192",
        type: "image/png",
        purpose: "any",
      },
      {
        src: "/icon-512-v1.png",
        sizes: "512x512",
        type: "image/png",
        purpose: "any",
      },
      {
        src: "/icon-maskable-192-v1.png",
        sizes: "192x192",
        type: "image/png",
        purpose: "maskable",
      },
      {
        src: "/icon-maskable-512-v1.png",
        sizes: "512x512",
        type: "image/png",
        purpose: "maskable",
      },
    ],
  };
}
