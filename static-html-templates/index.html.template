<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <!-- ==================================================================== -->
  <!-- 1. PRIMARY METADATA (Under 60 chars title, 130-160 chars description) -->
  <!-- ==================================================================== -->
  <title>Alex Mercer — Senior AI &amp; Full-Stack Systems Engineer</title>
  <meta name="description" content="Alex Mercer designs autonomous LLM agent systems, high-throughput cloud backends, and responsive web platforms. Available for select consulting and remote roles.">
  <meta name="keywords" content="AI Systems Engineer, Full-Stack Developer, LLM Integration, Autonomous Agents, Cloud Architecture, Python Backend, Software Engineering Portfolio">
  <meta name="author" content="Alex Mercer">
  <meta name="creator" content="Alex Mercer">
  <meta name="publisher" content="Alex Mercer">
  <meta name="theme-color" content="#0f172a">

  <!-- ==================================================================== -->
  <!-- 2. CANONICAL URL (Zero Canonical Drift: Always absolute, always uniform) -->
  <!-- ==================================================================== -->
  <link rel="canonical" href="https://yourdomain.com/">

  <!-- ==================================================================== -->
  <!-- 3. CRAWLER DIRECTIVES (Googlebot, Bingbot, Indexing & Preview Snippets) -->
  <!-- ==================================================================== -->
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
  <meta name="googlebot" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">

  <!-- ==================================================================== -->
  <!-- 4. OPEN GRAPH METADATA (Facebook, LinkedIn, Discord, WhatsApp)       -->
  <!-- Cache-Busting Rule: Always bump v1 to v2 when changing social images!  -->
  <!-- ==================================================================== -->
  <meta property="og:type" content="website">
  <meta property="og:locale" content="en_US">
  <meta property="og:site_name" content="Alex Mercer Portfolio">
  <meta property="og:url" content="https://yourdomain.com/">
  <meta property="og:title" content="Alex Mercer — Senior AI &amp; Full-Stack Systems Engineer">
  <meta property="og:description" content="Alex Mercer designs autonomous LLM agent systems, high-throughput cloud backends, and responsive web platforms. Available for select consulting and remote roles.">
  <meta property="og:image" content="https://yourdomain.com/og-image-v1.png">
  <meta property="og:image:secure_url" content="https://yourdomain.com/og-image-v1.png">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="Alex Mercer — Senior AI &amp; Full-Stack Systems Engineer">

  <!-- ==================================================================== -->
  <!-- 5. TWITTER / X CARDS                                                 -->
  <!-- ==================================================================== -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@yourusername">
  <meta name="twitter:creator" content="@yourusername">
  <meta name="twitter:title" content="Alex Mercer — Senior AI &amp; Full-Stack Systems Engineer">
  <meta name="twitter:description" content="Alex Mercer designs autonomous LLM agent systems, high-throughput cloud backends, and responsive web platforms. Available for select consulting and remote roles.">
  <meta name="twitter:image" content="https://yourdomain.com/og-image-v1.png">

  <!-- ==================================================================== -->
  <!-- 6. MULTI-RESOLUTION FAVICONS & TOUCH ICONS (Busts Google Favicon Cache) -->
  <!-- ==================================================================== -->
  <link rel="icon" href="/favicon-v1.ico" sizes="any">
  <link rel="icon" href="/favicon-v1.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/apple-touch-icon-v1.png" sizes="180x180">
  <link rel="manifest" href="/site.webmanifest">

  <!-- ==================================================================== -->
  <!-- 7. SEARCH CONSOLE VERIFICATION                                       -->
  <!-- ==================================================================== -->
  <meta name="google-site-verification" content="YOUR_GOOGLE_VERIFICATION_CODE">

  <!-- ==================================================================== -->
  <!-- 8. JSON-LD KNOWLEDGE GRAPH (Schema.org WebSite + Person + Speakable) -->
  <!-- ==================================================================== -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://yourdomain.com/#website",
        "url": "https://yourdomain.com/",
        "name": "Alex Mercer Portfolio",
        "alternateName": "Alex Mercer",
        "description": "Alex Mercer designs autonomous LLM agent systems, high-throughput cloud backends, and responsive web platforms.",
        "publisher": { "@id": "https://yourdomain.com/#main-entity" },
        "inLanguage": "en"
      },
      {
        "@type": "Person",
        "@id": "https://yourdomain.com/#main-entity",
        "name": "Alex Mercer",
        "givenName": "Alex",
        "familyName": "Mercer",
        "alternateName": "Alex",
        "identifier": "yourusername",
        "url": "https://yourdomain.com/",
        "image": "https://yourdomain.com/og-image-v1.png",
        "jobTitle": "Senior AI & Full-Stack Systems Engineer",
        "email": "mailto:contact@yourdomain.com",
        "description": "Senior AI Systems Engineer specializing in autonomous multi-agent architectures, scalable microservices, and AI-driven automation workflows.",
        "disambiguatingDescription": "Senior AI Systems Engineer based in San Francisco. Known on GitHub as @yourusername. Not to be confused with fictional characters, musicians, or athletes sharing the name Alex Mercer.",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "US"
        },
        "sameAs": [
          "https://github.com/yourusername",
          "https://www.linkedin.com/in/yourusername/",
          "https://x.com/yourusername",
          "https://www.instagram.com/yourusername/"
        ],
        "knowsAbout": [
          "AI Systems Engineering",
          "Autonomous Agents",
          "Retrieval-Augmented Generation (RAG)",
          "Python Microservices",
          "Distributed Systems",
          "Vector Databases"
        ],
        "speakable": {
          "@type": "SpeakableSpecification",
          "cssSelector": ["h1", ".hero-headline", ".entity-summary"]
        },
        "mainEntityOfPage": {
          "@type": "WebPage",
          "@id": "https://yourdomain.com/"
        }
      }
    ]
  }
  </script>
</head>
<body>
  <!-- Semantic Skip Link for Accessibility & SEO -->
  <a href="#main-content" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;">Skip to content</a>

  <main id="main-content">
    <header>
      <h1>Alex Mercer — Senior AI &amp; Full-Stack Systems Engineer</h1>
      <p class="hero-headline">Building deterministic AI agents, distributed backends, and high-performance web systems.</p>
    </header>

    <section class="entity-summary">
      <p>Based in San Francisco. Specializing in turning complex workflows into deterministic, production-grade software.</p>
    </section>
  </main>
</body>
</html>
